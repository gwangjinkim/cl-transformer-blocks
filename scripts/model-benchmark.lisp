(load "scripts/load.lisp")

(defun required-environment (name)
  (or (uiop:getenv name) (error "Missing environment variable ~A" name)))

(defun environment-integer (name)
  (parse-integer (required-environment name) :junk-allowed nil))

(defun benchmark-ids (batch tokens vocabulary &optional (offset 0))
  (let ((ids (make-array (list batch tokens))))
    (dotimes (index (array-total-size ids) ids)
      (setf (row-major-aref ids index)
            (+ 3 (mod (+ index offset) (- vocabulary 3)))))))

(defun tensor-fingerprint (tensor)
  (let ((tb::*backend* (tb::tensor-backend tensor)))
    (tb::with-tensor-scope
      (row-major-aref (tb:tensor-array (tb::tensor-sum tensor)) 0))))

(defun median (values)
  (let* ((sorted (sort (copy-list values) #'<))
         (middle (floor (length sorted) 2)))
    (if (oddp (length sorted)) (nth middle sorted)
        (/ (+ (nth (1- middle) sorted) (nth middle sorted)) 2.0d0))))

(defun run-prefill (model ids)
  (tb:forward model ids))

(defun run-training (model ids)
  (multiple-value-bind (loss gradients) (tb:loss-and-gradients model ids :labels ids)
    (mapc (lambda (entry) (tb:dispose (cdr entry))) gradients)
    loss))

(defun run-decode (model prefix next-ids steps &optional fingerprint-p)
  (tb:with-resource (cache (tb:make-cache model))
    (tb:with-resource (initial (tb:forward model prefix :cache cache))
      ;; WITH-RESOURCE's body is an evaluated cleanup form, not a declaration context.
      (tb:tensor-shape initial))
    (let ((start (get-internal-real-time)) (last nil))
      (unwind-protect
           (progn
             (dotimes (index steps)
               (when last (tb:dispose last))
               (setf last (tb:forward model next-ids :cache cache)))
             (values (/ (- (get-internal-real-time) start)
                        (* steps (float internal-time-units-per-second 1.0d0)))
                     (and fingerprint-p (tensor-fingerprint last))))
        (when last (tb:dispose last))))))

(let* ((source (uiop:ensure-directory-pathname (required-environment "TB_MODEL_BENCH_SOURCE")))
       (workload (string-downcase (required-environment "TB_MODEL_BENCH_WORKLOAD")))
       (device (if (equal (required-environment "TB_DEVICE") "gpu") :gpu :cpu))
       (batch (environment-integer "TB_MODEL_BENCH_BATCH"))
       (prefill-tokens (environment-integer "TB_MODEL_BENCH_PREFILL"))
       (decode-tokens (environment-integer "TB_MODEL_BENCH_DECODE"))
       (training-tokens (environment-integer "TB_MODEL_BENCH_TRAINING"))
       (warmups (environment-integer "TB_MODEL_BENCH_WARMUPS"))
       (repeats (environment-integer "TB_MODEL_BENCH_REPEATS"))
       (samples nil) (fingerprint nil))
  (tb:with-resource (model (tb:from-pretrained source :device device))
    (let* ((vocabulary (tb::config model "vocab_size"))
           (prefill (benchmark-ids batch prefill-tokens vocabulary))
           (training (benchmark-ids batch training-tokens vocabulary))
           (next (benchmark-ids batch 1 vocabulary prefill-tokens)))
      (labels ((warmup ()
                 (cond
                   ((equal workload "prefill")
                    (tb:with-resource (output (run-prefill model prefill))
                      (setf fingerprint (tensor-fingerprint output))))
                   ((equal workload "training")
                    (setf fingerprint (run-training model training)))
                   ((equal workload "decode")
                    (multiple-value-bind (seconds value)
                        (run-decode model prefill next decode-tokens t)
                      (declare (ignore seconds))
                      (setf fingerprint value)))
                   (t (error "Unknown workload ~A" workload)))))
        ;; The warmup fingerprint validates equivalent work outside latency timing.
        (dotimes (index warmups) (declare (ignore index)) (warmup))
        (unless fingerprint (warmup))
        (tb:reset-backend-peak-memory (tb:model-backend model))
        (dotimes (index repeats)
          (declare (ignore index))
          (cond
            ((equal workload "decode")
             (push (run-decode model prefill next decode-tokens) samples))
            ((equal workload "prefill")
             (let ((start (get-internal-real-time)))
               (tb:with-resource (output (run-prefill model prefill))
                 (push (/ (- (get-internal-real-time) start)
                          (float internal-time-units-per-second 1.0d0)) samples))))
            (t
             (let ((start (get-internal-real-time)))
               (run-training model training)
               (push (/ (- (get-internal-real-time) start)
                        (float internal-time-units-per-second 1.0d0)) samples)))))
        (let ((memory (tb:backend-memory (tb:model-backend model)))
              (result (make-hash-table :test 'equal)))
          (setf (gethash "frontend" result) "common-lisp-mlx"
                (gethash "workload" result) workload
                (gethash "actual_device" result) (string-downcase device)
                (gethash "device_api" result)
                (if (eq device :cpu) "mlx-cpu" #+darwin "metal" #-darwin "cuda")
                (gethash "dtype" result) "float32"
                (gethash "samples_seconds" result) (coerce (nreverse samples) 'vector)
                (gethash "fingerprint" result) fingerprint
                (gethash "allocator_memory" result)
                (let ((table (make-hash-table :test 'equal)))
                  (setf (gethash "active_bytes" table) (getf memory :active)
                        (gethash "cache_bytes" table) (getf memory :cache)
                        (gethash "peak_bytes" table) (getf memory :peak))
                  table))
          (yason:encode result *standard-output*)
          (terpri))))))
